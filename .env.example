# Required: Generate at https://huggingface.co/settings/tokens
# Also accept the model license at https://huggingface.co/google/gemma-4-E2B-it
HF_TOKEN=API_KEY_HERE
# Model selection examples:
#   google/gemma-4-E2B-it  (~6GB RAM, ~4-6 tokens/sec on CPU)
#   google/gemma-4-E4B-it  (~11GB RAM, ~2-3 tokens/sec on CPU)
MODEL_ID=google/gemma-4-E2B-it

# Local directory where model weights are cached after first download
HF_CACHE_DIR=./model_cache

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Inference defaults (can be overridden per-request)
MAX_NEW_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
