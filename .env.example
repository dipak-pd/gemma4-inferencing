# HuggingFace token — optional for public LiteRT community models
# Generate at https://huggingface.co/settings/tokens if needed for private repos
HF_TOKEN=

# LiteRT model repo and filename
# E2B (~4GB download, ~4-6 tokens/sec on CPU):
MODEL_ID=litert-community/gemma-4-E2B-it-litert-lm
MODEL_FILENAME=gemma-4-E2B-it.litertlm
#
# E4B (~8GB download, ~2-3 tokens/sec on CPU):
# MODEL_ID=litert-community/gemma-4-E4B-it-litert-lm
# MODEL_FILENAME=gemma-4-E4B-it.litertlm

# Local directory where the model file is cached after first download
HF_CACHE_DIR=./model_cache

# Server
HOST=0.0.0.0
PORT=7000
LOG_LEVEL=info
